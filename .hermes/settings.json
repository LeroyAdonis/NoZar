{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-check-update.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-update-banner.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-context-monitor.js",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-read-injection-scanner.js",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-prompt-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-read-guard.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/nvm/v22.19.0/node.exe\" \"$CLAUDE_PROJECT_DIR\"/.hermes/hooks/gsd-workflow-guard.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
