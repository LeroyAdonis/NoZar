# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it contains secrets.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Better Auth ──────────────────────────────────────────────────────────────
# Must match the URL the server is actually reachable on.
# Better Auth appends /api/auth/callback/google to construct the OAuth redirect
# URI — that URI must be registered in Google Cloud Console exactly.
#
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Set Authorized redirect URIs to:
#   http://localhost:3000/api/auth/callback/google   (local dev)
#   https://your-domain.com/api/auth/callback/google (production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Africa's Talking — Phone OTP ─────────────────────────────────────────────
# Sign up at https://africastalking.com and create an application.
# For local development use the sandbox (free, no real SMS sent).
AFRICASTALKING_API_KEY=your_africastalking_api_key
AFRICASTALKING_USERNAME=sandbox        # or your AT username for production
AFRICASTALKING_SANDBOX=true            # set to false in production

# ─── NVIDIA AI — Listing Assist, Matching, Chat & Safe Meetup Spots ──────────
# Get a NIM API key from NVIDIA and use it for every AI feature in Nozar.
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY

# ─── Google Maps — Map View ───────────────────────────────────────────────────
# Enable the Maps JavaScript API at https://console.cloud.google.com/apis/library
# Required for the map view (/dashboard/map) and meetup location pins.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Blob Storage — Image Uploads ──────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=your_blob_storage_read_write_token

# ─── Email (Transactional) ────────────────────────────────────────────────────
# Required for new-message alerts, trade-accepted / completed notifications,
# and contact-sharing emails (see app/lib/email.server.ts).
#
# The app uses the Resend SDK — sign up free at https://resend.com and create
# an API key. Verify a sending domain or use Resend's shared domain for testing.
#
# Without this key all email sends are silently skipped (no crash, just a
# console.warn logged once at startup).
RESEND_API_KEY=re_your_resend_api_key_here

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Generate keys once with: node scripts/generate-vapid.mjs
# Paste the output below. VAPID_PUBLIC_KEY is also exposed to the client.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:hello@nozar.co.za

# ─── PayFast — Billing & Subscriptions ───────────────────────────────────────
# Sign up at https://www.payfast.co.za and create a merchant account.
# Use sandbox credentials for local development and Vercel preview deployments.
# NEVER set live credentials outside a production environment.
#
# Sandbox dashboard: https://sandbox.payfast.co.za
# Live dashboard:    https://my.payfast.co.za
#
# PAYFAST_MODE controls which PayFast endpoint is used:
#   sandbox  → https://sandbox.payfast.co.za/eng/process  (no real money)
#   live     → https://www.payfast.co.za/eng/process       (real charges)
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
