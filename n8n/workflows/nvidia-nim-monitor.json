{"updatedAt":"2026-06-07T22:09:45.188Z","createdAt":"2026-06-07T22:09:45.188Z","id":"ZZ6XNTYK9SAOgACk","name":"NVIDIA NIM Model Monitor + Auto-Fix","description":null,"active":true,"isArchived":false,"nodes":[{"id":"a1b2c3d4-e5f6-7890-abcd-ef1234567890","name":"Every 12h","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.1,"position":[250,300],"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":12}]}}},{"id":"b2c3d4e5-f6a7-8901-bcde-f12345678901","name":"Fetch NIM Models","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[550,300],"parameters":{"url":"https://integrate.api.nvidia.com/v1/models","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.NVIDIA_API_KEY }}"}]},"options":{}}},{"id":"c3d4e5f6-a7b8-9012-cdef-123456789012","name":"Check Models","type":"n8n-nodes-base.code","typeVersion":2,"position":[850,300],"parameters":{"language":"python","code":"import json\n\nCONFIGURED_MODELS = {\n    'default': 'meta/llama-4-maverick-17b-128e-instruct',\n    'support_chat': 'meta/llama-3.1-8b-instruct',\n    'vision': 'google/gemma-3n-e4b-it',\n    'embeddings': 'nvidia/nv-embedqa-e5-v5',\n    'fraud': 'meta/llama-4-maverick-17b-128e-instruct',\n}\n\nFALLBACKS = {\n    'meta/llama-4-maverick-17b-128e-instruct': [\n        'meta/llama-3.3-70b-instruct', 'nvidia/llama-3.3-nemotron-super-49b-v1',\n    ],\n    'meta/llama-3.1-8b-instruct': ['meta/llama-3.2-3b-instruct'],\n    'google/gemma-3n-e4b-it': ['google/gemma-3n-e2b-it', 'qwen/qwen3.5-122b-a10b'],\n    'nvidia/nv-embedqa-e5-v5': ['nvidia/nv-embed-v1', 'nvidia/nv-embedqa-mistral-7b-v2'],\n}\n\navailable = set()\nraw = json.loads(items[0]['json']['body'])\nfor m in raw.get('data', []):\n    available.add(m['id'])\n\nmissing = []\nfor role, model in CONFIGURED_MODELS.items():\n    if model not in available:\n        suggestions = FALLBACKS.get(model, [])\n        fb = next((f for f in suggestions if f in available), None)\n        missing.append({'role': role, 'model': model, 'suggested': fb, 'suggestions': suggestions})\n\nreturn [{'json': {\n    'checked_at': str(__import__('datetime').datetime.now()),\n    'total_models': len(available),\n    'missing_count': len(missing),\n    'changes': missing,\n    'needs_attention': len(missing) > 0,\n}}]"}},{"id":"d4e5f6a7-b8c9-0123-defa-234567890123","name":"Models Missing?","type":"n8n-nodes-base.if","typeVersion":2,"position":[1150,300],"parameters":{"conditions":{"boolean":[{"value1":"={{ $json.needs_attention }}","operation":"equal"}]}}},{"id":"e5f6a7b8-c9d0-1234-efab-345678901234","name":"All Good — Nothing to Do","type":"n8n-nodes-base.noOp","typeVersion":1,"position":[1150,500],"parameters":{}},{"id":"f6a7b8c9-d0e1-2345-fabc-456789012345","name":"Email Alert (Brevo)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1450,250],"parameters":{"url":"https://api.brevo.com/v3/smtp/email","method":"POST","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api-key","value":"={{ $env.BREVO_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"jsonBody":"={\n  'sender': {'name': 'NoZar AI Watchdog', 'email': 'hello@nozar.co.za'},\n  'to': [{'email': 'leroy@nozar.co.za'}],\n  'subject': '🚨 NVIDIA NIM: Model Change Detected',\n  'htmlContent': '<div style=\"font-family:system-ui;background:#030712;color:#e2e8f0;padding:24px;border-radius:12px\">' +\n    '<h2 style=\"color:#f43f5e;margin:0 0 16px\">🚨 NVIDIA NIM MODEL CHANGE ALERT</h2>' +\n    '<p>NoZar uses <b>' + str($json.missing_count) + '</b> model(s) that are no longer available:</p>' +\n    '<table style=\"width:100%;border-collapse:collapse\">' +\n    '<tr style=\"background:#1e293b\"><th style=\"padding:8px;border:1px solid #334155\">Feature</th><th style=\"padding:8px;border:1px solid #334155\">Missing Model</th><th style=\"padding:8px;border:1px solid #334155\">Suggested Replacement</th></tr>' +\n    ($json.changes | map(c => '<tr><td style=\"padding:8px;border:1px solid #334155\">' + c.role + '</td><td style=\"padding:8px;border:1px solid #334155\"><code>' + c.model + '</code></td><td style=\"padding:8px;border:1px solid #334155\"><code>' + (c.suggested or 'Needs investigation') + '</code></td></tr>')).join('') +\n    '</table><p style=\"color:#94a3b8;font-size:12px;margin-top:16px\">Automated check from n8n. Update NoZar codebase: app/lib/*.server.ts</p></div>'\n}"}},{"id":"a7b8c9d0-e1f2-3456-abcd-567890123456","name":"Alert Webhook (NoZar)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1450,450],"parameters":{"url":"https://nozar.co.za/api/n8n/nim-alert","method":"POST","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Authorization","value":"=Bearer {{ $env.N8N_API_KEY }}"},{"name":"Content-Type","value":"application/json"}]},"jsonBody":"={{ $json.changes | map(c => ({'model': c.model, 'role': c.role, 'suggested': c.suggested})) }}"}}],"connections":{"Every 12h":{"main":[[{"node":"Fetch NIM Models","type":"main","index":0}]]},"Fetch NIM Models":{"main":[[{"node":"Check Models","type":"main","index":0}]]},"Check Models":{"main":[[{"node":"Models Missing?","type":"main","index":0}]]},"Models Missing?":{"main":[[{"node":"Email Alert (Brevo)","type":"main","index":0},{"node":"Alert Webhook (NoZar)","type":"main","index":1}],[{"node":"All Good — Nothing to Do","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":{"node:Every 12h":{"recurrenceRules":[]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"b5423b49-6b4f-4898-aa46-faac3335f687","activeVersionId":"b5423b49-6b4f-4898-aa46-faac3335f687","versionCounter":1,"triggerCount":1,"tags":[{"updatedAt":"2026-06-07T22:09:45.195Z","createdAt":"2026-06-07T22:09:45.195Z","id":"Tw7BMVdQwLwvXu5G"